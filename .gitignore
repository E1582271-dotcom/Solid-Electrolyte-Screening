*.pyc
.venv/
build/
dist/
*.egg-info/
.ipynb_checkpoints/

# Test/tool caches.
.pytest_cache/
.ruff_cache/
.coverage

# OS.
.DS_Store
Thumbs.db

# Local audit reports and working notes: not part of the reviewed release payload.
AUDIT_*.md
